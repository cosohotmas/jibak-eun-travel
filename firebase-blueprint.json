{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A travel-item purchase and delivery tracking record belonging to an authenticated user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the buyer",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "buyerName": {
          "type": "string",
          "description": "Recipient name",
          "minLength": 1,
          "maxLength": 60
        },
        "buyerEmail": {
          "type": "string",
          "format": "email",
          "description": "Buyer email address",
          "maxLength": 120
        },
        "departureDate": {
          "type": "string",
          "description": "Planned departure date (YYYY-MM-DD)",
          "minLength": 4,
          "maxLength": 20
        },
        "paymentMethod": {
          "type": "string",
          "description": "Selected payment method",
          "minLength": 2,
          "maxLength": 40
        },
        "shippingAddress": {
          "type": "string",
          "description": "Combined delivery address",
          "maxLength": 200
        },
        "shippingZipCode": {
          "type": "string",
          "description": "Delivery postal/zip code",
          "maxLength": 10
        },
        "shippingBaseAddress": {
          "type": "string",
          "description": "Base road or jibun address",
          "maxLength": 150
        },
        "shippingDetailAddress": {
          "type": "string",
          "description": "Detailed address (unit, building, floor)",
          "maxLength": 100
        },
        "selectedOptionsSummary": {
          "type": "string",
          "description": "Summary of chosen size/color options",
          "maxLength": 500
        },
        "transportModes": {
          "type": "array",
          "description": "Selected transport mode IDs (max 7)"
        },
        "itemSummary": {
          "type": "string",
          "description": "Readable summary of ordered items",
          "minLength": 1,
          "maxLength": 500
        },
        "items": {
          "type": "array",
          "description": "Bounded list of ordered items (max 15)"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order price in KRW"
        },
        "shippingStatus": {
          "type": "string",
          "enum": ["결제완료", "상품준비중", "배송중", "배송완료"],
          "description": "Current delivery status"
        },
        "courier": {
          "type": "string",
          "description": "Courier company name",
          "maxLength": 40
        },
        "trackingNumber": {
          "type": "string",
          "description": "Shipping tracking number",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "userId",
        "buyerName",
        "buyerEmail",
        "departureDate",
        "paymentMethod",
        "itemSummary",
        "items",
        "totalAmount",
        "shippingStatus",
        "courier",
        "trackingNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A customer inquiry submitted to the seller.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the inquirer",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Email of the inquirer",
          "maxLength": 120
        },
        "orderId": {
          "type": "string",
          "description": "Optional related order ID",
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "enum": ["상품 문의", "배송 문의", "교환·환불", "기타"],
          "description": "Inquiry category"
        },
        "subject": {
          "type": "string",
          "description": "Inquiry title",
          "minLength": 2,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Inquiry message body",
          "minLength": 5,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["답변 대기", "답변 완료"],
          "description": "Seller reply status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "userId",
        "userEmail",
        "category",
        "subject",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Checklist": {
      "title": "Checklist",
      "description": "A saved 3-split travel checklist receipt with selected transport modes.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Checklist display title",
          "minLength": 1,
          "maxLength": 100
        },
        "destination": {
          "type": "string",
          "description": "Travel destination",
          "maxLength": 60
        },
        "duration": {
          "type": "string",
          "description": "Trip duration",
          "maxLength": 40
        },
        "theme": {
          "type": "string",
          "description": "Trip theme",
          "maxLength": 40
        },
        "companion": {
          "type": "string",
          "description": "Travel companion",
          "maxLength": 40
        },
        "transportModes": {
          "type": "array",
          "description": "Selected transport modes (max 7)"
        },
        "haveItems": {
          "type": "array",
          "description": "Items to bring from home (max 30)"
        },
        "buyItems": {
          "type": "array",
          "description": "Items to buy at storefront (max 30)"
        },
        "localItems": {
          "type": "array",
          "description": "Items converted to local procurement (max 30)"
        },
        "carrierType": {
          "type": "string",
          "description": "Selected carrier preset",
          "maxLength": 40
        },
        "loadPercent": {
          "type": "number",
          "description": "Calculated carrier load percentage"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "userId",
        "title",
        "destination",
        "duration",
        "theme",
        "companion",
        "transportModes",
        "haveItems",
        "buyItems",
        "localItems",
        "carrierType",
        "loadPercent",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Authenticated user purchase orders and shipping tracking records."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Authenticated user 1:1 inquiries sent to the seller."
    },
    "/checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/Checklist" },
      "description": "Authenticated user saved 3-split custom travel checklists."
    }
  }
}
